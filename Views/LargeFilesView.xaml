<UserControl
    x:Class="PurgeWin.Views.LargeFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PurgeWin.Controls"
    xmlns:m="using:PurgeWin.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="28,16,28,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="Fichiers volumineux" Style="{StaticResource PageTitleText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CalloutText}" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <c:PurgeButton x:Name="KeepOneBtn" Content="Garder un exemplaire de chaque" Variant="Secondary" Click="OnKeepOneClick" Visibility="Collapsed"/>
                <c:PurgeButton x:Name="ScanBtn" Content="Analyser" Variant="Secondary" Click="OnScanClick"/>
                <c:PurgeButton x:Name="CleanSelectedBtn" Content="Envoyer à la Corbeille" Variant="Primary" Click="OnCleanSelectedClick"/>
            </StackPanel>
        </Grid>

        <!-- Category Chips -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6" Padding="28,4,28,10">
                <c:PurgeButton x:Name="ChipAll" Content="Tout" Size="Compact" Variant="Secondary" Click="OnChipClick" Tag="All"/>
                <c:PurgeButton x:Name="ChipVideo" Content="Vidéos" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Video"/>
                <c:PurgeButton x:Name="ChipArchive" Content="Archives" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Archive"/>
                <c:PurgeButton x:Name="ChipDisk" Content="Images disque" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="DiskImage"/>
                <c:PurgeButton x:Name="ChipVm" Content="Machines virtuelles" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="VirtualMachine"/>
                <c:PurgeButton x:Name="ChipAi" Content="Modèles IA" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="AiModel"/>
                <c:PurgeButton x:Name="ChipDup" Content="Doublons" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Duplicate"/>
                <c:PurgeButton x:Name="ChipCloud" Content="OneDrive" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="OneDrive"/>
                <c:PurgeButton x:Name="ChipDoc" Content="Documents" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Document"/>
                <c:PurgeButton x:Name="ChipImage" Content="Images" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Image"/>
                <c:PurgeButton x:Name="ChipAudio" Content="Audio" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Audio"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Search + Size & Age Filters -->
        <Grid Grid.Row="2" Padding="24,8" Background="{ThemeResource SurfacePrimary}" BorderBrush="{ThemeResource Hairline}" BorderThickness="0,1,0,1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" PlaceholderText="Rechercher un fichier..." TextChanged="OnSearchChanged" FontSize="12" CornerRadius="8"/>
            <TextBlock Grid.Column="1" x:Name="SelectionSummary" Style="{StaticResource PurgeCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <ComboBox Grid.Column="2" x:Name="SizeCombo" SelectionChanged="OnSizeChanged" SelectedIndex="0" FontSize="12" CornerRadius="8">
                <ComboBoxItem Content="&gt; 5 MB"/>
                <ComboBoxItem Content="&gt; 50 MB"/>
                <ComboBoxItem Content="&gt; 250 MB"/>
                <ComboBoxItem Content="&gt; 1 GB"/>
            </ComboBox>

            <ComboBox Grid.Column="3" x:Name="AgeCombo" SelectionChanged="OnAgeChanged" SelectedIndex="0" FontSize="12" CornerRadius="8">
                <ComboBoxItem x:Name="AgeAllItem" Content="Tout âge"/>
                <ComboBoxItem x:Name="Age30Item" Content="&gt; 30 jours"/>
                <ComboBoxItem x:Name="Age90Item" Content="&gt; 90 jours"/>
                <ComboBoxItem x:Name="Age365Item" Content="&gt; 1 an"/>
            </ComboBox>
        </Grid>

        <!-- File List -->
        <Grid Grid.Row="3">
            <ListView x:Name="FilesListView" SelectionMode="None" Padding="24,14">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:LargeFileItem">
                        <Border Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7" Background="{ThemeResource FillSecondary}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Background="{x:Bind BadgeBgBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind BadgeFgBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource PurgeBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource PurgeCaption}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="OnEvictCloudClick" Visibility="{x:Bind CloudActionVisibility}" CornerRadius="14" Padding="10,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE753;" FontSize="11"/>
                                            <TextBlock Text="OneDrive"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource PurgeMono}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Tag="{x:Bind FullPath}" Click="OnRevealClick" Background="Transparent" BorderThickness="0" Padding="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                <FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="Aucun fichier volumineux à afficher" Style="{StaticResource PurgeSection}" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondary}"/>
                <TextBlock x:Name="EmptySubtitle" Text="Lancez une analyse pour repérer vidéos, archives, ISO, VMs, modèles IA et doublons." Style="{StaticResource PurgeCaption}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
