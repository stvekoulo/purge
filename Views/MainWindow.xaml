<Window
    x:Class="PurgeWin.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:PurgeWin.Views"
    xmlns:c="using:PurgeWin.Controls"
    Title="Purge">

  <Grid x:Name="RootGrid" Background="{ThemeResource SurfaceBase}">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnScanCurrentShortcut"/>
      <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="OnScanAllShortcut"/>
      <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnTab1Shortcut"/>
      <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnTab2Shortcut"/>
      <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnTab3Shortcut"/>
      <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnTab4Shortcut"/>
      <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnTab5Shortcut"/>
    </Grid.KeyboardAccelerators>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="244"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar Column -->
    <Grid Grid.Column="0" Background="{ThemeResource SurfaceCard}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Brand Mark Header + Theme & Language Quick Toggles -->
      <Grid Grid.Row="0" Margin="16,28,12,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Interactive Animated Brand Logo -->
        <Grid Grid.Column="0" Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center">
          <ProgressRing x:Name="LogoCleaningRing" Width="30" Height="30"
                        IsActive="False" Visibility="Collapsed"
                        Foreground="{ThemeResource ActionPrimary}"/>
          <Image x:Name="BrandLogoImage" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                <RotateTransform x:Name="LogoRotate" Angle="0"/>
              </TransformGroup>
            </Image.RenderTransform>
          </Image>
          <FontIcon x:Name="BrandCleanSparkle" Glyph="&#xE735;" FontSize="11" Foreground="#F59E0B"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                    Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="Purge" Style="{StaticResource SectionTitleText}"/>
          <TextBlock x:Name="TxtBrandCleaningStatus" Text="" FontSize="10" FontWeight="SemiBold"
                     Foreground="{ThemeResource ActionPrimary}" Visibility="Collapsed"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="2" x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click"
                CornerRadius="12" Padding="7,2" Height="24" MinWidth="0" Margin="0,0,4,0"
                Background="{ThemeResource FillSecondary}" BorderThickness="0"
                ToolTipService.ToolTip="Thème Clair / Sombre (Light / Dark)">
          <FontIcon x:Name="IconThemeToggle" Glyph="&#xE706;" FontSize="11"/>
        </Button>
        <Button Grid.Column="3" x:Name="BtnLangToggle" Click="BtnLangToggle_Click"
                CornerRadius="12" Padding="8,2" Height="24" MinWidth="0"
                Background="{ThemeResource FillSecondary}" BorderThickness="0"
                ToolTipService.ToolTip="Français / English">
          <TextBlock x:Name="TxtLangBadge" Text="FR" FontSize="11" FontWeight="SemiBold"/>
        </Button>
      </Grid>

      <!-- Navigation Items -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="2" Padding="8,0,8,8">
          <Button x:Name="NavOverview" Click="NavOverview_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="8,6" CornerRadius="{StaticResource RadiusMd}"
                  Background="Transparent" BorderThickness="0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="TxtNavOverview" Text="Vue d'ensemble" Style="{StaticResource BodyText}" FontWeight="Medium"/>
            </Grid>
          </Button>

          <TextBlock x:Name="TxtSecClean" Text="Nettoyer" Style="{StaticResource SidebarSectionText}"/>

          <Button x:Name="NavAppCaches" Click="NavAppCaches_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="8,6" CornerRadius="{StaticResource RadiusMd}"
                  Background="Transparent" BorderThickness="0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="TxtNavCaches" Text="Caches d'apps" Style="{StaticResource BodyText}" FontWeight="Medium"/>
              <TextBlock Grid.Column="2" x:Name="TxtAppCachesBadge" Text="" Style="{StaticResource MetadataText}"
                         FontWeight="SemiBold" Foreground="{ThemeResource TextTertiary}"/>
            </Grid>
          </Button>

          <Button x:Name="NavDevTools" Click="NavDevTools_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="8,6" CornerRadius="{StaticResource RadiusMd}"
                  Background="Transparent" BorderThickness="0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE943;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="TxtNavDev" Text="Outils de dev" Style="{StaticResource BodyText}" FontWeight="Medium"/>
              <TextBlock Grid.Column="2" x:Name="TxtDevToolsBadge" Text="" Style="{StaticResource MetadataText}"
                         FontWeight="SemiBold" Foreground="{ThemeResource TextTertiary}"/>
            </Grid>
          </Button>

          <TextBlock x:Name="TxtSecReview" Text="Vérifier" Style="{StaticResource SidebarSectionText}"/>

          <Button x:Name="NavLargeFiles" Click="NavLargeFiles_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="8,6" CornerRadius="{StaticResource RadiusMd}"
                  Background="Transparent" BorderThickness="0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="TxtNavLarge" Text="Fichiers volumineux" Style="{StaticResource BodyText}" FontWeight="Medium"/>
              <TextBlock Grid.Column="2" x:Name="TxtLargeFilesBadge" Text="" Style="{StaticResource MetadataText}"
                         FontWeight="SemiBold" Foreground="{ThemeResource TextTertiary}"/>
            </Grid>
          </Button>

          <Button x:Name="NavUninstaller" Click="NavUninstaller_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="8,6" CornerRadius="{StaticResource RadiusMd}"
                  Background="Transparent" BorderThickness="0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="TxtNavUninstall" Text="Désinstalleur" Style="{StaticResource BodyText}" FontWeight="Medium"/>
              <TextBlock Grid.Column="2" x:Name="TxtUninstallBadge" Text="" Style="{StaticResource MetadataText}"
                         FontWeight="SemiBold" Foreground="{ThemeResource TextTertiary}"/>
            </Grid>
          </Button>

          <Border Height="1" Background="{ThemeResource BorderSubtle}" Margin="8,8,8,8"/>

          <Button x:Name="NavSettings" Click="NavSettings_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="8,6" CornerRadius="{StaticResource RadiusMd}"
                  Background="Transparent" BorderThickness="0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="TxtNavSettings" Text="Réglages" Style="{StaticResource BodyText}" FontWeight="Medium"/>
            </Grid>
          </Button>

          <Button x:Name="NavAbout" Click="NavAbout_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="8,6" CornerRadius="{StaticResource RadiusMd}"
                  Background="Transparent" BorderThickness="0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="TxtNavAbout" Text="À propos" Style="{StaticResource BodyText}" FontWeight="Medium"/>
              <Border Grid.Column="2" x:Name="BadgeNavAboutUpdate" Visibility="Collapsed"
                      CornerRadius="8" Padding="5,1" Background="{ThemeResource ActionPrimary}" VerticalAlignment="Center">
                <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="White"/>
              </Border>
            </Grid>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <!-- Bottom Card: Recycle Bin Summary (click to open Windows Recycle Bin) -->
      <Button Grid.Row="2" x:Name="BtnOpenRecycleBin" Click="BtnOpenRecycleBin_Click"
              Margin="12,8,12,14" Padding="12,10"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Background="{ThemeResource FillSecondary}" BorderThickness="0"
              CornerRadius="{StaticResource RadiusLg}"
              ToolTipService.ToolTip="Ouvrir la Corbeille Windows / Open Windows Recycle Bin">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
          <TextBlock Grid.Column="1" x:Name="TxtTrashSummary" Text="Corbeille..."
                     Style="{StaticResource CalloutText}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
          <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="11" Foreground="{ThemeResource TextTertiary}"/>
        </Grid>
      </Button>
    </Grid>

    <!-- Hairline Divider -->
    <Rectangle Grid.Column="1" Fill="{ThemeResource BorderSubtle}"/>

    <!-- Main Detail Content Area -->
    <Grid Grid.Column="2" Background="{ThemeResource SurfaceBase}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Update Notification Banner -->
      <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
              Background="{ThemeResource FillSecondary}"
              BorderBrush="{ThemeResource ActionPrimary}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
              Margin="24,20,24,0" Padding="14,10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource ActionPrimary}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TxtUpdateBannerTitle" Text="Mise à jour disponible" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="TxtUpdateBannerDesc" Text="Une nouvelle version de Purge est disponible." FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
          </StackPanel>
          <c:PurgeButton Grid.Column="2" x:Name="BtnBannerDownload" Content="Télécharger" Role="Primary" Size="Compact" Click="BtnBannerDownload_Click" VerticalAlignment="Center"/>
          <Button Grid.Column="3" x:Name="BtnBannerDismiss" Click="BtnBannerDismiss_Click" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" x:Name="DetailHost" Margin="0,16,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <v:OnboardingOverlay Grid.RowSpan="2" x:Name="OnboardingControl" Visibility="Collapsed"/>
      <v:CelebrationOverlay Grid.RowSpan="2" x:Name="CelebrationControl" Visibility="Collapsed"/>
    </Grid>

    <!-- Custom TitleBar Drag Region across top of window -->
    <Border x:Name="TitleBarDragRegion" Grid.ColumnSpan="3" Height="28"
            VerticalAlignment="Top" Background="Transparent" IsHitTestVisible="True"/>
  </Grid>
</Window>
