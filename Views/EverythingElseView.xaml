<UserControl x:Class="PurgeWin.Views.EverythingElseView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="using:PurgeWin.Controls" xmlns:m="using:PurgeWin.Models">
  <ScrollViewer x:Name="ExplorerScroll" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Visible"
                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Padding="24,16,24,30">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <c:PurgeButton x:Name="BackBtn" Content="← Vue d'ensemble" Variant="Ghost" Size="Compact" Click="OnBackClick"/>
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock x:Name="PageTitle" Text="Explorer l'espace disque" Style="{StaticResource PageTitleText}" TextWrapping="Wrap"/>
          <TextBlock x:Name="PageSubtitle" Style="{StaticResource CalloutText}" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
        <c:PurgeButton x:Name="RefreshBtn" Grid.Column="2" Content="Actualiser" Size="Compact" Click="OnRefreshClick"/>
      </Grid>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="ParentBtn" Content="←" Click="OnParentClick" AutomationProperties.Name="Revenir au dossier précédent"/>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
          <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" Spacing="4"/>
        </ScrollViewer>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressRing x:Name="FolderBusy" Width="16" Height="16" Visibility="Collapsed" IsActive="False"/>
        <TextBlock x:Name="FolderStatus" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid ColumnSpacing="10" RowSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button Click="OnBucketClick" Tag="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" CornerRadius="10">
          <StackPanel Spacing="4"><TextBlock x:Name="Bucket1Title" Text="Géré dans les apps" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock x:Name="Bucket1Size" FontWeight="SemiBold" Foreground="{ThemeResource ManagedInApps}"/></StackPanel>
        </Button>
        <Button Grid.Column="1" Click="OnBucketClick" Tag="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" CornerRadius="10">
          <StackPanel Spacing="4"><TextBlock x:Name="Bucket2Title" Text="Vos fichiers" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock x:Name="Bucket2Size" FontWeight="SemiBold" Foreground="{ThemeResource YourFiles}"/></StackPanel>
        </Button>
        <Button Grid.Row="1" Click="OnBucketClick" Tag="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" CornerRadius="10">
          <StackPanel Spacing="4"><TextBlock x:Name="Bucket3Title" Text="Profils et données d'apps" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock x:Name="Bucket3Size" FontWeight="SemiBold" Foreground="{ThemeResource LeftAlone}"/></StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="1" Click="OnBucketClick" Tag="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" CornerRadius="10">
          <StackPanel Spacing="4"><TextBlock x:Name="Bucket4Title" Text="Géré par Windows" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock x:Name="Bucket4Size" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}"/></StackPanel>
        </Button>
      </Grid>
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="FolderSearch" PlaceholderText="Rechercher un dossier ou un chemin" TextChanged="OnSearchChanged"/>
        <ComboBox x:Name="BucketPicker" Grid.Column="1" MinWidth="140" SelectionChanged="OnBucketChanged" AutomationProperties.Name="Catégorie de dossiers"/>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ToggleSwitch x:Name="MapToggle" Header="Carte proportionnelle" IsOn="True" Toggled="OnMapToggled"/>
        <ComboBox x:Name="SortPicker" Grid.Column="1" MinWidth="140" SelectionChanged="OnSortChanged" AutomationProperties.Name="Trier les dossiers"/>
      </Grid>
      <Border x:Name="MapCard" Style="{StaticResource PurgeCard}" Padding="8">
        <Canvas x:Name="TreemapCanvas" Height="320" SizeChanged="OnCanvasSizeChanged"/>
      </Border>
      <Border x:Name="Inspector" Style="{StaticResource PurgeCard}" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock x:Name="SelectedNameText" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="SelectedSizeText" Style="{StaticResource CalloutText}"/>
          <TextBlock x:Name="SelectedDescText" Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          <TextBlock x:Name="SelectedAdviceText" Style="{StaticResource MetadataText}" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondary}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <c:PurgeButton x:Name="ExploreBtn" Content="Explorer le dossier" Role="Primary" Size="Compact" Click="OnExploreClick"/>
            <c:PurgeButton x:Name="RevealBtn" Content="Afficher dans Windows" Size="Compact" Click="OnRevealSelectedClick"/>
            <Button x:Name="CopyPathBtn" Click="OnCopyPath" Padding="6" AutomationProperties.Name="Copier le chemin">
              <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="FolderCount" Style="{StaticResource HeadlineText}" TextWrapping="Wrap"/>
      <TextBlock x:Name="EmptyText" Text="Aucun résultat" Style="{StaticResource CalloutText}" Visibility="Collapsed" TextWrapping="Wrap"/>
      <ItemsControl x:Name="FolderRows">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="m:EverythingElseFolder">
          <Grid Margin="0,0,0,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Click="OnFolderSelected" DoubleTapped="OnFolderDoubleTapped" Tag="{x:Bind}" Padding="12,10"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8" AutomationProperties.Name="{x:Bind DisplayName}">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind LocationText}" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Grid.Column="1" Tag="{x:Bind}" IsEnabled="{x:Bind IsDirectory}" Click="OnNavigateFolder" Padding="10"
                  AutomationProperties.Name="Explorer le dossier" ToolTipService.ToolTip="Explorer le dossier / Explore folder">
            <FontIcon Glyph="&#xE76C;" FontSize="12"/>
          </Button>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:PurgeButton x:Name="MoreButton" Content="Afficher plus" Click="OnMore" HorizontalAlignment="Center" Visibility="Collapsed"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
