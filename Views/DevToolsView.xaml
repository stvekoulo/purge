<UserControl
    x:Class="PurgeWin.Views.DevToolsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PurgeWin.Controls"
    xmlns:m="using:PurgeWin.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="28,16,28,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="Outils de dev" Style="{StaticResource PageTitleText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CalloutText}" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <c:PurgeButton x:Name="ScanBtn" Content="Analyser" Variant="Secondary" Click="OnScanClick"/>
                <c:PurgeButton x:Name="CleanSelectedBtn" Content="Nettoyer la sélection" Variant="Primary" Click="OnCleanSelectedClick"/>
            </StackPanel>
        </Grid>

        <!-- Section Filter Chips -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      BorderBrush="{ThemeResource Hairline}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="28,6,28,12">
                <c:PurgeButton x:Name="FilterAllBtn" Content="Tout" Size="Compact" Variant="Secondary" Click="OnFilterAllClick"/>
                <c:PurgeButton x:Name="FilterGlobalBtn" Content="Caches globaux" Size="Compact" Variant="Ghost" Click="OnFilterGlobalClick"/>
                <c:PurgeButton x:Name="FilterProjectsBtn" Content="Projets de dev" Size="Compact" Variant="Ghost" Click="OnFilterProjectsClick"/>
                <c:PurgeButton x:Name="FilterAvdBtn" Content="Émulateurs Android" Size="Compact" Variant="Ghost" Click="OnFilterAvdClick"/>
                <c:PurgeButton x:Name="FilterWorktreesBtn" Content="Worktrees IA" Size="Compact" Variant="Ghost" Click="OnFilterWorktreesClick"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Selection & Sort Bar -->
        <Grid Grid.Row="2" Padding="24,8" Background="{ThemeResource SurfacePrimary}" BorderBrush="{ThemeResource Hairline}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CheckBox x:Name="SelectAllCheck" Content="Tout sélectionner" Click="OnSelectAllClick" MinWidth="0"/>
                <TextBlock x:Name="SelectionSummary" Style="{StaticResource PurgeCaption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="SortLabel" Text="Trier par :" Style="{StaticResource PurgeCaption}" VerticalAlignment="Center"/>
                <ComboBox x:Name="SortCombo" SelectionChanged="OnSortChanged" SelectedIndex="0" FontSize="12" CornerRadius="8">
                    <ComboBoxItem x:Name="SortLargestItem" Content="Plus volumineux"/>
                    <ComboBoxItem x:Name="SortNameItem" Content="Nom"/>
                    <ComboBoxItem x:Name="SortDateItem" Content="Date de modification"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Items List -->
        <Grid Grid.Row="3">
            <ListView x:Name="DevListView" SelectionMode="None" Padding="24,14">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:DevItem">
                        <Border Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" MinWidth="0" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{ThemeResource FillSecondary}" VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{x:Bind IconSource}" Width="20" Height="20"
                                               Visibility="{x:Bind IconVisibility}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Stretch="Uniform"/>
                                        <FontIcon Glyph="&#xE943;" FontSize="15" Foreground="{ThemeResource TextSecondary}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{x:Bind FallbackIconVisibility}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource PurgeBody}" FontWeight="SemiBold"/>
                                        <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource FillSecondary}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SectionBadge, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Background="{x:Bind BadgeBgBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SafetyText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind BadgeFgBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Explanation, Mode=OneWay}" Style="{StaticResource PurgeCaption}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource PurgeMono}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Tag="{x:Bind PrimaryPath}" Click="OnRevealItemClick" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="{x:Bind RevealHint, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                                    </Button>
                                    <Button Tag="{x:Bind PrimaryPath}" Click="OnExcludeItemClick" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="{x:Bind ExcludeHint, Mode=OneWay}">
                                        <FontIcon Glyph="&#xECC9;" FontSize="13" Foreground="{ThemeResource TextTertiary}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                <FontIcon Glyph="&#xE943;" FontSize="44" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="Aucun cache ou artefact de développement" Style="{StaticResource PurgeSection}" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondary}"/>
                <TextBlock x:Name="EmptySubtitle" Text="Lancez une analyse pour inspecter npm, NuGet, Cargo, Gradle et vos projets." Style="{StaticResource PurgeCaption}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
