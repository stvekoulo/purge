<UserControl
    x:Class="PurgeWin.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PurgeWin.Controls"
    xmlns:s="using:PurgeWin.Services">

  <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="22" Padding="28,16,28,32" HorizontalAlignment="Stretch">

      <!-- Page Header -->
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="2">
          <TextBlock x:Name="TxtPageTitle" Text="Réglages" Style="{StaticResource PageTitleText}"/>
          <TextBlock x:Name="TxtPageSub" Text="Apparence, langue, automatisation et historique"
                     Style="{StaticResource CalloutText}" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
        <c:PurgeButton Grid.Column="1" x:Name="BtnReplayOnboarding" Content="Visite d'accueil"
                       Role="Secondary" Size="Compact" Click="OnReplayOnboardingClick" VerticalAlignment="Center"/>
      </Grid>

      <!-- Visual Appearance Cards (System / Light / Dark) + Language -->
      <StackPanel Spacing="8">
        <TextBlock x:Name="TxtSecAppearance" Text="Apparence &amp; Langue" Style="{StaticResource SectionTitleText}"/>
        <Border Style="{StaticResource Card}" Padding="16,14">
          <StackPanel Spacing="14">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" x:Name="BtnThemeAuto" Click="OnThemeCardClick" Tag="system"
                      HorizontalAlignment="Stretch" Padding="8" CornerRadius="10" Background="Transparent" BorderThickness="2">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <Border Height="52" Width="88" CornerRadius="6">
                    <Border.Background>
                      <ImageBrush ImageSource="ms-appx:///Assets/appearance-auto.png" Stretch="UniformToFill"/>
                    </Border.Background>
                  </Border>
                  <TextBlock x:Name="TxtThemeAuto" Text="Système" Style="{StaticResource CalloutText}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Grid.Column="1" x:Name="BtnThemeLight" Click="OnThemeCardClick" Tag="light"
                      HorizontalAlignment="Stretch" Padding="8" CornerRadius="10" Background="Transparent" BorderThickness="2">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <Border Height="52" Width="88" CornerRadius="6">
                    <Border.Background>
                      <ImageBrush ImageSource="ms-appx:///Assets/appearance-light.png" Stretch="UniformToFill"/>
                    </Border.Background>
                  </Border>
                  <TextBlock x:Name="TxtThemeLight" Text="Clair" Style="{StaticResource CalloutText}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Grid.Column="2" x:Name="BtnThemeDark" Click="OnThemeCardClick" Tag="dark"
                      HorizontalAlignment="Stretch" Padding="8" CornerRadius="10" Background="Transparent" BorderThickness="2">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <Border Height="52" Width="88" CornerRadius="6">
                    <Border.Background>
                      <ImageBrush ImageSource="ms-appx:///Assets/appearance-dark.png" Stretch="UniformToFill"/>
                    </Border.Background>
                  </Border>
                  <TextBlock x:Name="TxtThemeDark" Text="Sombre" Style="{StaticResource CalloutText}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLangTitle" Text="Langue / Language" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtLangSub" Text="Basculer instantanément entre le français et l'anglais" Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
              </StackPanel>
              <ComboBox x:Name="CmbLang" Grid.Column="1" SelectionChanged="CmbLang_SelectionChanged"
                        Height="30" CornerRadius="{StaticResource RadiusMd}" FontSize="13" VerticalAlignment="Center">
                <ComboBoxItem Content="Français"/>
                <ComboBoxItem Content="English"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Section: Automatisation & Projets -->
      <StackPanel Spacing="8">
        <TextBlock x:Name="TxtSecAutomation" Text="Automatisation &amp; Projets" Style="{StaticResource SectionTitleText}"/>
        <Border Style="{StaticResource Card}" Padding="16,14">
          <StackPanel Spacing="14">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStartupTitle" Text="Lancer au démarrage de Windows" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtStartupSub" Text="Démarre Purge automatiquement à l'ouverture de session" Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" x:Name="TglStartup" Toggled="OnStartupToggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtScheduleTitle" Text="Nettoyage automatique sécurisé" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtScheduleSub" Text="Nettoie uniquement les caches marqués « Sûr » vers la Corbeille" Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
              </StackPanel>
              <ComboBox x:Name="CmbSchedule" Grid.Column="1" SelectionChanged="CmbSchedule_SelectionChanged"
                        Height="30" CornerRadius="{StaticResource RadiusMd}" FontSize="13" VerticalAlignment="Center">
                <ComboBoxItem x:Name="SchedOffItem" Content="Désactivé"/>
                <ComboBoxItem x:Name="SchedWeeklyItem" Content="Chaque semaine"/>
                <ComboBoxItem x:Name="SchedMonthlyItem" Content="Chaque mois"/>
                <ComboBoxItem x:Name="SchedQuarterlyItem" Content="Chaque trimestre"/>
              </ComboBox>
            </Grid>

            <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStaleTitle" Text="Ancienneté des artefacts de projets" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtStaleSub" Text="Filtrer node_modules, target et .next selon leur dernière modification" Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
              </StackPanel>
              <ComboBox x:Name="CmbStale" Grid.Column="1" SelectionChanged="CmbStale_SelectionChanged"
                        Height="30" CornerRadius="{StaticResource RadiusMd}" FontSize="13" VerticalAlignment="Center">
                <ComboBoxItem x:Name="StaleAllItem" Content="Tous les projets"/>
                <ComboBoxItem Content="&gt; 30 jours / days"/>
                <ComboBoxItem Content="&gt; 90 jours / days"/>
                <ComboBoxItem Content="&gt; 180 jours / days"/>
              </ComboBox>
            </Grid>

            <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtAutoUpdateTitle" Text="Vérifier les mises à jour au démarrage" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtAutoUpdateSub" Text="Recherche discrètement si une nouvelle version est disponible sur GitHub" Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" x:Name="TglAutoUpdate" Toggled="OnAutoUpdateToggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

            <StackPanel Spacing="8">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="TxtCustomRootsTitle" Text="Dossiers de projets personnalisés" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TxtCustomRootsSub" Text="Dossiers supplémentaires inspectés par Outils de dev" Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
                </StackPanel>
                <c:PurgeButton Grid.Column="1" x:Name="BtnAddProjectFolder" Content="+ Ajouter" Role="Secondary" Size="Compact" Click="OnAddProjectFolderClick" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel x:Name="CustomRootsPanel" Spacing="4"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Section: Historique de nettoyage -->
      <StackPanel Spacing="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TxtSecHistory" Text="Historique des nettoyages" Style="{StaticResource SectionTitleText}"/>
          <TextBlock Grid.Column="1" x:Name="TxtLifetimeTotal" Style="{StaticResource MetadataText}" FontWeight="SemiBold"/>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="16,14">
          <StackPanel Spacing="8">
            <TextBlock x:Name="TxtHistoryEmpty" Text="Aucun nettoyage effectué pour le moment."
                       Style="{StaticResource CalloutText}" Visibility="Collapsed"/>
            <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="200">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="s:HistoryEntry">
                  <Grid Padding="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{x:Bind DateText}" Style="{StaticResource RowTitleText}"/>
                      <TextBlock Text="{x:Bind SummaryText}" Style="{StaticResource CalloutText}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind FreedText}" Style="{StaticResource NumbersText}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Section: Emplacements exclus & Désinstallation -->
      <StackPanel Spacing="8">
        <TextBlock x:Name="TxtSecExclusions" Text="Dossiers exclus &amp; Maintenance" Style="{StaticResource SectionTitleText}"/>
        <Border Style="{StaticResource Card}" Padding="16,14">
          <StackPanel Spacing="12">
            <TextBlock x:Name="TxtExclusionsSub" Text="Les dossiers que vous avez demandé à Purge d'ignorer lors des analyses."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtNoExclusions" Text="Aucun dossier exclu."
                       Style="{StaticResource CalloutText}" FontWeight="Medium"
                       Foreground="{ThemeResource TextSecondary}"/>
            <StackPanel x:Name="ExclusionsPanel" Spacing="4"/>
            <Border Height="1" Background="{ThemeResource BorderSubtle}"/>
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TxtSelfUninstallDesc" Text="Retirer la tâche planifiée, le démarrage automatique et les réglages locaux."
                         Style="{StaticResource CalloutText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <c:PurgeButton Grid.Column="1" x:Name="BtnSelfUninstall" Content="Désinstaller Purge..."
                             Role="Destructive" Size="Compact" Click="OnSelfUninstallClick" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
