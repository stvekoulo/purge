<UserControl
    x:Class="PurgeWin.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PurgeWin.Controls">

  <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20" Padding="28,22,28,32" HorizontalAlignment="Stretch">

      <!-- Header with Icon -->
      <StackPanel Spacing="12">
        <Image Width="76" Height="76" HorizontalAlignment="Left"
               Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform"/>

        <StackPanel Spacing="4">
          <TextBlock Text="Purge" Style="{StaticResource TitleText}"/>
          <TextBlock x:Name="TxtVersion" Text="Version 1.0.1 pour Windows" Style="{StaticResource CalloutText}"
                     Foreground="{ThemeResource TextSecondary}"/>
          <TextBlock x:Name="TxtTagline" Text="Libérez votre PC. En toute sécurité." Style="{StaticResource HeadlineText}"
                     Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>

      <!-- Update Card -->
      <Border Style="{StaticResource Card}" Padding="20,16">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <FontIcon x:Name="IconUpdateStatus" Glyph="&#xE895;" FontSize="15" Foreground="{ThemeResource ActionPrimary}"/>
              <TextBlock x:Name="TxtUpdateHeader" Text="Mises à jour du logiciel" Style="{StaticResource RowTitleText}"/>
              <Border x:Name="BadgeUpdateState" CornerRadius="8" Padding="6,2" Visibility="Collapsed"
                      Background="{ThemeResource ActionPrimary}">
                <TextBlock x:Name="TxtBadgeUpdateState" Text="Nouveau" FontSize="10" FontWeight="Bold" Foreground="White"/>
              </Border>
            </StackPanel>

            <TextBlock x:Name="TxtUpdateStatus"
                       Text="Recherchez si une nouvelle version est disponible sur GitHub."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <c:PurgeButton x:Name="BtnCheckUpdate" Content="Vérifier les mises à jour"
                           Role="Secondary" Size="Compact" Click="BtnCheckUpdate_Click"/>
            <c:PurgeButton x:Name="BtnDownloadUpdate" Content="Télécharger"
                           Role="Primary" Size="Compact" Visibility="Collapsed" Click="BtnDownloadUpdate_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Details Card -->
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock x:Name="TxtCard1Title" Text="Corbeille par défaut" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtCard1Body" Text="Les fichiers supprimés sont toujours envoyés dans la Corbeille de Windows et ne sont jamais effacés définitivement sans votre accord."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

          <StackPanel Spacing="4">
            <TextBlock x:Name="TxtCard2Title" Text="Liste autorisée stricte (Allowlist)" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtCard2Body" Text="Seuls les répertoires et caches répertoriés dans le catalogue officiel sont nettoyés automatiquement. Rien d'inconnu n'est touché."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

          <StackPanel Spacing="4">
            <TextBlock x:Name="TxtCard3Title" Text="Support multi-disques &amp; Confidentialité totale" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtCard3Body" Text="Analyse tous vos disques locaux (C:, D:, E:...) entièrement hors-ligne. Aucune donnée ni télémétrie n'est envoyée sur Internet."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
