<UserControl
    x:Class="PurgeWin.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="24" Padding="28,22,28,32" HorizontalAlignment="Stretch">

      <!-- Header with Icon -->
      <StackPanel Spacing="12">
        <Image Width="76" Height="76" HorizontalAlignment="Left"
               Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform"/>

        <StackPanel Spacing="4">
          <TextBlock Text="Purge" Style="{StaticResource TitleText}"/>
          <TextBlock x:Name="TxtVersion" Text="Version 1.0.0 pour Windows" Style="{StaticResource CalloutText}"
                     Foreground="{ThemeResource TextSecondary}"/>
          <TextBlock x:Name="TxtTagline" Text="Libérez votre PC. En toute sécurité." Style="{StaticResource HeadlineText}"
                     Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>

      <!-- Details Card -->
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock x:Name="TxtCard1Title" Text="Corbeille par défaut" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtCard1Body" Text="Les fichiers supprimés sont toujours envoyés dans la Corbeille de Windows et ne sont jamais effacés définitivement sans votre accord."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

          <StackPanel Spacing="4">
            <TextBlock x:Name="TxtCard2Title" Text="Liste autorisée stricte (Allowlist)" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtCard2Body" Text="Seuls les répertoires et caches répertoriés dans le catalogue officiel sont nettoyés automatiquement. Rien d'inconnu n'est touché."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          </StackPanel>

          <Border Height="1" Background="{ThemeResource BorderSubtle}"/>

          <StackPanel Spacing="4">
            <TextBlock x:Name="TxtCard3Title" Text="Support multi-disques &amp; Confidentialité totale" Style="{StaticResource RowTitleText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtCard3Body" Text="Analyse tous vos disques locaux (C:, D:, E:...) entièrement hors-ligne. Aucune donnée ni télémétrie n'est envoyée sur Internet."
                       Style="{StaticResource CalloutText}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
