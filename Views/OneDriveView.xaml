<UserControl
    x:Class="PurgeWin.Views.OneDriveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PurgeWin.Controls"
    xmlns:m="using:PurgeWin.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="28,16,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="OneDrive" Style="{StaticResource PageTitleText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CalloutText}" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <c:PurgeButton x:Name="ScanBtn" Content="Analyser" Variant="Secondary" Click="OnScanClick"/>
                <c:PurgeButton x:Name="EvictSelectedBtn" Content="Libérer l'espace local" Variant="Secondary" Click="OnEvictSelectedClick"/>
                <c:PurgeButton x:Name="CleanSelectedBtn" Content="Envoyer à la Corbeille" Variant="Primary" Click="OnCleanSelectedClick"/>
            </StackPanel>
        </Grid>

        <!-- Summary Cards (Local vs Cloud-only vs Pinned) -->
        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtLocalCardLabel" Text="Sur ce PC (Local)" Style="{StaticResource PurgeCaption}" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBlock x:Name="TxtLocalCardBytes" Text="0 o" Style="{StaticResource SectionTitleText}" Foreground="{ThemeResource StatusSafeText}"/>
                    <TextBlock x:Name="TxtLocalCardSub" Text="0 fichier occupé sur le disque" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtCloudCardLabel" Text="En ligne uniquement (Cloud)" Style="{StaticResource PurgeCaption}" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBlock x:Name="TxtCloudCardBytes" Text="0 o" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock x:Name="TxtCloudCardSub" Text="0 fichier (0 o occupé sur ce PC)" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtPinnedCardLabel" Text="Toujours gardés (Épinglés)" Style="{StaticResource PurgeCaption}" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBlock x:Name="TxtPinnedCardBytes" Text="0 o" Style="{StaticResource SectionTitleText}" Foreground="{ThemeResource StatusCheckText}"/>
                    <TextBlock x:Name="TxtPinnedCardSub" Text="0 fichier épinglé hors ligne" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter Chips -->
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6" Padding="28,0,28,10">
                <c:PurgeButton x:Name="ChipAll" Content="Tout" Size="Compact" Variant="Secondary" Click="OnChipClick" Tag="All"/>
                <c:PurgeButton x:Name="ChipLocal" Content="Sur ce PC (Local)" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Local"/>
                <c:PurgeButton x:Name="ChipCloud" Content="En ligne uniquement (Cloud)" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="CloudOnly"/>
                <c:PurgeButton x:Name="ChipPinned" Content="Toujours gardés (Épinglés)" Size="Compact" Variant="Ghost" Click="OnChipClick" Tag="Pinned"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Toolbar: Select All + Search + Summary + Sort -->
        <Grid Grid.Row="3" Padding="24,8" Background="{ThemeResource SurfacePrimary}" BorderBrush="{ThemeResource Hairline}" BorderThickness="0,1,0,1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MaxWidth="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" x:Name="SelectAllCheck" Content="Tout sélectionner" Click="OnSelectAllClick" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Rechercher dans OneDrive..." TextChanged="OnSearchChanged" FontSize="12" CornerRadius="8"/>
            <TextBlock Grid.Column="2" x:Name="SelectionSummary" Style="{StaticResource PurgeCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <ComboBox Grid.Column="3" x:Name="SortCombo" SelectionChanged="OnSortChanged" SelectedIndex="0" FontSize="12" CornerRadius="8">
                <ComboBoxItem x:Name="SortSizeItem" Content="Taille (décroissante)"/>
                <ComboBoxItem x:Name="SortDateItem" Content="Date de modification"/>
                <ComboBoxItem x:Name="SortNameItem" Content="Nom (A–Z)"/>
            </ComboBox>
        </Grid>

        <!-- File List -->
        <Grid Grid.Row="4">
            <ListView x:Name="FilesListView" SelectionMode="None" Padding="24,14">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:OneDriveFileItem">
                        <Border Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7" Background="{ThemeResource FillSecondary}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Background="{x:Bind BadgeBgBrush, Mode=OneWay}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind BadgeFgBrush, Mode=OneWay}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource PurgeBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource PurgeCaption}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Click="OnEvictItemClick" Visibility="{x:Bind EvictButtonVisibility, Mode=OneWay}" CornerRadius="14" Padding="10,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE753;" FontSize="11"/>
                                            <TextBlock Text="{x:Bind EvictButtonLabel, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource PurgeMono}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind SizeNoteText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <Button Tag="{x:Bind FullPath}" Click="OnRevealClick" Background="Transparent" BorderThickness="0" Padding="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                <FontIcon Glyph="&#xE753;" FontSize="44" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="Aucun fichier OneDrive à afficher" Style="{StaticResource PurgeSection}" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondary}"/>
                <TextBlock x:Name="EmptySubtitle" Text="Analysez votre dossier OneDrive pour visualiser les fichiers stockés sur ce PC ou en ligne uniquement." Style="{StaticResource PurgeCaption}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
