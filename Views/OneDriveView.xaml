<UserControl
    x:Class="PurgeWin.Views.OneDriveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:PurgeWin.Controls"
    xmlns:m="using:PurgeWin.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="28,16,28,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="OneDrive" Style="{StaticResource PageTitleText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CalloutText}" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <c:PurgeButton x:Name="ScanBtn" Content="Analyser" Variant="Secondary" Click="OnScanClick"/>
                <c:PurgeButton x:Name="EvictSelectedBtn" Content="Libérer l'espace local" Variant="Secondary" Click="OnEvictSelectedClick"/>
                <c:PurgeButton x:Name="CleanSelectedBtn" Content="Envoyer à la Corbeille" Variant="Primary" Click="OnCleanSelectedClick"/>
            </StackPanel>
        </Grid>

        <!-- Interactive Filter Cards + Proportional Storage Bar -->
        <StackPanel Grid.Row="1" Padding="28,0,28,14" Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 0: All OneDrive Files -->
                <Border Grid.Column="0" x:Name="CardAll" CornerRadius="12" BorderThickness="1" Padding="0"
                        Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource BorderStrong}">
                    <Button Tag="All" Click="OnFilterCardClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="13,11" CornerRadius="11">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource ChartAppCachesTile}">
                                    <FontIcon Glyph="&#xE753;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="TxtAllCardLabel" Text="Tout OneDrive" Style="{StaticResource MetadataText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="TxtAllCardBytes" Text="0 o" FontFamily="{StaticResource Numbers}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtAllCardSub" Text="0 fichier" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Card 1: On This PC (Local) -->
                <Border Grid.Column="1" x:Name="CardLocal" CornerRadius="12" BorderThickness="1" Padding="0"
                        Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}">
                    <Button Tag="Local" Click="OnFilterCardClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="13,11" CornerRadius="11">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource StatusSafeFill}">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="12" Foreground="{ThemeResource StatusSafeText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="TxtLocalCardLabel" Text="Sur ce PC" Style="{StaticResource MetadataText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="TxtLocalCardBytes" Text="0 o" FontFamily="{StaticResource Numbers}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource StatusSafeText}"/>
                            <TextBlock x:Name="TxtLocalCardSub" Text="0 fichier · libérable" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Card 2: Online-only (Cloud) -->
                <Border Grid.Column="2" x:Name="CardCloud" CornerRadius="12" BorderThickness="1" Padding="0"
                        Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}">
                    <Button Tag="CloudOnly" Click="OnFilterCardClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="13,11" CornerRadius="11">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource FillSecondary}">
                                    <FontIcon Glyph="&#xE753;" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="TxtCloudCardLabel" Text="En ligne" Style="{StaticResource MetadataText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="TxtCloudCardBytes" Text="0 o" FontFamily="{StaticResource Numbers}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtCloudCardSub" Text="0 fichier · 0 o sur PC" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Card 3: Always Kept (Pinned) -->
                <Border Grid.Column="3" x:Name="CardPinned" CornerRadius="12" BorderThickness="1" Padding="0"
                        Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}">
                    <Button Tag="Pinned" Click="OnFilterCardClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="13,11" CornerRadius="11">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource StatusCheckFill}">
                                    <FontIcon Glyph="&#xE718;" FontSize="12" Foreground="{ThemeResource StatusCheckText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="TxtPinnedCardLabel" Text="Épinglés" Style="{StaticResource MetadataText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="TxtPinnedCardBytes" Text="0 o" FontFamily="{StaticResource Numbers}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource StatusCheckText}"/>
                            <TextBlock x:Name="TxtPinnedCardSub" Text="0 fichier · hors ligne" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>

            <!-- Proportional Storage Bar (Local vs Pinned vs Online) -->
            <Border Height="6" CornerRadius="3" Background="{ThemeResource FillSecondary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColBarLocal" Width="0"/>
                        <ColumnDefinition x:Name="ColBarPinned" Width="0"/>
                        <ColumnDefinition x:Name="ColBarCloud" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{ThemeResource StatusSafeText}"/>
                    <Rectangle Grid.Column="1" Fill="{ThemeResource StatusCheckText}"/>
                    <Rectangle Grid.Column="2" Fill="{ThemeResource ChartAppCaches}" Opacity="0.45"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Toolbar: Select All + Summary (Left) | Search + Sort (Right) -->
        <Grid Grid.Row="2" Padding="28,9,28,9" Background="{ThemeResource SurfacePrimary}" BorderBrush="{ThemeResource Hairline}" BorderThickness="0,1,0,1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" x:Name="SelectAllCheck" Content="Tout sélectionner" IsThreeState="True" Click="OnSelectAllClick" MinWidth="0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="SelectionSummary" Style="{StaticResource PurgeCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" PlaceholderText="Rechercher un fichier..." TextChanged="OnSearchChanged" FontSize="12" CornerRadius="8" Width="210"/>
                <ComboBox x:Name="SortCombo" SelectionChanged="OnSortChanged" SelectedIndex="0" FontSize="12" CornerRadius="8" MinWidth="160">
                    <ComboBoxItem x:Name="SortSizeItem" Content="Taille (décroissante)"/>
                    <ComboBoxItem x:Name="SortDateItem" Content="Date de modification"/>
                    <ComboBoxItem x:Name="SortNameItem" Content="Nom (A–Z)"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- File List -->
        <Grid Grid.Row="3">
            <ListView x:Name="FilesListView" SelectionMode="None" Padding="28,14,28,24">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:OneDriveFileItem">
                        <Border Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" CornerRadius="12" Padding="14,11"
                                PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="{x:Bind IconBgBrush, Mode=OneWay}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{x:Bind IconFgBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource RowTitleText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="340" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="7,2" Background="{x:Bind BadgeBgBrush, Mode=OneWay}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="{x:Bind BadgeGlyph, Mode=OneWay}" FontSize="9" Foreground="{x:Bind BadgeFgBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind BadgeFgBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Click="OnEvictItemClick" Visibility="{x:Bind EvictButtonVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind EvictTooltip, Mode=OneWay}"
                                            Background="{ThemeResource FillSecondary}" BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="1"
                                            CornerRadius="14" Padding="10,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="{ThemeResource StatusSafeText}"/>
                                            <TextBlock Text="{x:Bind EvictButtonLabel, Mode=OneWay}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="1" VerticalAlignment="Center" MinWidth="82">
                                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource NumbersText}" Foreground="{x:Bind SizeFgBrush, Mode=OneWay}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind SizeNoteText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <Button Tag="{x:Bind FullPath}" Click="OnRevealClick" ToolTipService.ToolTip="{x:Bind RevealTooltip, Mode=OneWay}"
                                            Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                <FontIcon Glyph="&#xE753;" FontSize="44" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="Aucun fichier OneDrive dans cette vue" Style="{StaticResource PurgeSection}" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondary}"/>
                <TextBlock x:Name="EmptySubtitle" Text="Changez de filtre ou lancez une analyse pour inspecter vos fichiers OneDrive." Style="{StaticResource PurgeCaption}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
