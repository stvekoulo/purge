<UserControl x:Class="PurgeWin.Controls.DriveScopeBar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:m="using:PurgeWin.Models">
  <Border Margin="24,12,24,0" Padding="14,10" Background="{ThemeResource SurfaceCard}"
          BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="1" CornerRadius="10">
    <Grid ColumnSpacing="10" RowSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ScopeLabel" Text="Disque" Style="{StaticResource CalloutText}" VerticalAlignment="Center"/>
      <ComboBox x:Name="DrivePicker" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="170"
                SelectionChanged="OnDriveChanged" AutomationProperties.Name="Disque affiché dans toutes les analyses">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="m:DriveVolumeItem">
          <TextBlock Text="{x:Bind PickerTitle}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button x:Name="StopButton" Grid.Column="2" Click="OnStop" Content="Arrêter" Visibility="Collapsed"/>
      <Button x:Name="RefreshButton" Grid.Column="3" Click="OnRefresh" Padding="8" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
      </Button>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8">
        <ProgressRing x:Name="ScanRing" Width="13" Height="13" IsActive="False" Visibility="Collapsed"/>
        <TextBlock x:Name="ScopeStatus" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondary}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
