<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PurgeWin</RootNamespace>
    <AssemblyName>Purge</AssemblyName>
    <Platforms>x64;ARM64;x86</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64;win-x86</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.12</Version>
    <FileVersion>1.0.12.0</FileVersion>
    <AssemblyVersion>1.0.12.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UpdatePreview)' == 'true'">
    <DefineConstants>$(DefineConstants);PURGE_UPDATE_PREVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UxTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PURGE_UX_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Include="Tests\UpdatePreview.cs" Condition="'$(UpdatePreview)' == 'true'" />
    <Compile Include="Tests\ScopeIntegrationProbe.cs" Condition="'$(UxTest)' == 'true'" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged WinUI views are indexed in this generated PRI. The SDK's
       publish output omits it; a successful build alone cannot detect this. -->
  <Target Name="PublishWinUIResources" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The generated WinUI resource index $(AssemblyName).pri is missing." />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
